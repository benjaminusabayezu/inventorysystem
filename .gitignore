# =============================================
# Airtel Inventory - .gitignore
# =============================================

# Maven build output
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# H2 database files (never commit these)
data/
*.mv.db
*.trace.db
*.lock.db

# Logs
logs/
*.log

# Environment / secrets
.env
*.env
application-local.properties

# IDE files
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Windows file locks
*.lck